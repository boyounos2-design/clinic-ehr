# Copy to .env and fill in. NEVER commit the real .env.
DOMAIN=ehr.example.com                 # your domain, pointing at this server
EHR_ENV=production
EHR_ADMIN_PASSWORD=change-me-12+chars  # first start only: creates the admin account (no demo users in production)
# EHR_ADMIN_USER=admin
# EHR_JWT_SECRET=                      # optional; otherwise generated once and kept in the data volume
# ANTHROPIC_API_KEY=sk-ant-...         # live AI sheet reading (images are sent to Anthropic)
# OCRSPACE_API_KEY=                    # trial reader only; do not use with real patient data
